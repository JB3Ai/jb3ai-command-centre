# OS³ Command Centre — environment variables
# ─────────────────────────────────────────────────────────────────────────
# Local dev:  copy this file to `.env.local` and fill in the values below.
#             `.env.local` is gitignored via the `*.local` pattern.
#
# Production: set the SAME three vars in Vercel:
#             Project → Settings → Environment Variables
#             Apply to: Production + Preview + Development.
#             After adding/changing a var, redeploy for it to take effect.
# ─────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────
# Project: uxeolplwhtyyefpmwktw (eu-west-1)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-jwt-here

# ── Auth lockdown ─────────────────────────────────────────
# Comma-separated emails allowed to request a magic link.
# Server-side enforcement also lives in Supabase Auth dashboard
# (Auth → Providers → Email → "Allow signups" OFF + invite-only).
# Production callback URL must be added to Supabase:
#   Auth → URL Configuration → Site URL       = https://command.jb3ai.com
#   Auth → URL Configuration → Redirect URLs += https://command.jb3ai.com/auth/callback
VITE_AUTH_ALLOWED_EMAILS=jono@jonoblackburn.com

# ── Local Development Auth ────────────────────────────────
# For local development, you can temporarily allow all emails
# VITE_AUTH_ALLOWED_EMAILS=*

# ── Supabase Auth Redirect URLs ───────────────────────────
# For local development, set these to your local URLs
# VITE_SUPABASE_REDIRECT_URL=http://localhost:5173/auth/callback
